# Copy to .env (never commit .env) and fill in, then: python3 tools/configure.py OUT_DIR
# Project URL of the Supabase project the copy should use (https://<ref>.supabase.co, or http://127.0.0.1:54321 locally)
SUPABASE_URL=https://your-project-ref.supabase.co
# Public anon / publishable key of that project (never the service_role or sb_secret_ key)
SUPABASE_ANON_KEY=your-anon-or-publishable-key
