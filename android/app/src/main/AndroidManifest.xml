<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Mərkəz"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Taps on the home-screen widget. Android 13+ only delivers intents that match a filter. -->
            <intent-filter>
                <action android:name="az.ruqya.zapis.OPEN" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="ruqya" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".MonthWidget"
            android:exported="true"
            android:label="Mərkəz — ay">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <intent-filter>
                <action android:name="az.ruqya.zapis.WIDGET_PREV" />
                <action android:name="az.ruqya.zapis.WIDGET_NEXT" />
                <data android:scheme="ruqya" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/month_widget_info" />
        </receiver>

        <receiver
            android:name=".WidgetTest"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="az.ruqya.zapis.WIDGET_TEST" />
                <action android:name="az.ruqya.zapis.WIDGET_BIND_TEST" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
