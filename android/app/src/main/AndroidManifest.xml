<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- owner 18.11: «Kontaktlara əlavə et» — patients' names and numbers into the phone's contacts (asked on first use) -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!-- 24.11 notifications (off until the specialist turns them on): show them, exact reminders, keep the check after a restart -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Mərkəz"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Taps on the home-screen widget. Android 13+ only delivers intents that match a filter. -->
            <intent-filter>
                <action android:name="az.ruqya.zapis.OPEN" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="ruqya" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".MonthWidget"
            android:exported="true"
            android:label="Mərkəz — ay">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <intent-filter>
                <action android:name="az.ruqya.zapis.WIDGET_PREV" />
                <action android:name="az.ruqya.zapis.WIDGET_NEXT" />
                <data android:scheme="ruqya" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/month_widget_info" />
        </receiver>

        <!-- owner 23.11: «gündəlik» widget -->
        <receiver
            android:name=".DayWidget"
            android:exported="true"
            android:label="Mərkəz — gün">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <intent-filter>
                <action android:name="az.ruqya.zapis.DAY_PREV" />
                <action android:name="az.ruqya.zapis.DAY_NEXT" />
                <data android:scheme="ruqya" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/day_widget_info" />
        </receiver>

        <!-- owner 23.11: «həftəlik» widget -->
        <receiver
            android:name=".WeekWidget"
            android:exported="true"
            android:label="Mərkəz — həftə">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <intent-filter>
                <action android:name="az.ruqya.zapis.WEEK_PREV" />
                <action android:name="az.ruqya.zapis.WEEK_NEXT" />
                <data android:scheme="ruqya" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/week_widget_info" />
        </receiver>

        <!-- 24.11 notifications: the check every 15 minutes, the reminders' alarms, set up again after a restart -->
        <service
            android:name=".NotifyJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver
            android:name=".NotifyAlarm"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".WidgetTest"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="az.ruqya.zapis.WIDGET_TEST" />
                <action android:name="az.ruqya.zapis.WIDGET_BIND_TEST" />
                <action android:name="az.ruqya.zapis.CONTACTS_TEST" />
                <action android:name="az.ruqya.zapis.NOTIFY_TEST" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
